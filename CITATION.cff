title: "elixhauser-ahrq: Python reimplementation of AHRQ Elixhauser Comorbidity Software Refined for ICD-10-CM"
version: "2027.1.0"
url: "https://github.com/fopelka-EOCS/elixhauser-ahrq"
repository-code: "https://github.com/fopelka-EOCS/elixhauser-ahrq"
license: MIT
authors:
  - family-names: "Opelka"
    given-names: "Frank G."
    affiliation: "Episodes of Care Solutions (EOCS)"
